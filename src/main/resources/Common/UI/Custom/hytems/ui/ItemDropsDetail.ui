$C = "../../Common.ui";

Group #DropDetailContent {
  LayoutMode: Top;

  Group #ItemHeader {
    LayoutMode: Left;
    Anchor: (Height: 124);
    Padding: (Full: 10);
    Background: #172331(0.88);

    Group {
      Anchor: (Width: 70, Height: 70);
      Background: #ffffff(0.04);
      LayoutMode: Center;

      ItemIcon #DropDetailItemIcon {
        Anchor: (Width: 64, Height: 64);
        Visible: true;
      }
    }

    Group {
      Anchor: (Width: 12);
    }

    Group #NameSection {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 16);

      Label #DropDetailItemName {
        Text: "";
        Anchor: (Height: 30);
        Style: (
          FontSize: 17,
          TextColor: #ffffff,
          RenderBold: true,
          VerticalAlignment: Center
        );
      }

      Group {
        Anchor: (Height: 10);
      }

      Group #ItemActions {
        Anchor: (Height: 28);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DropPinButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DropPinButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }

        Group {
          Anchor: (Width: 10);
        }

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DropFavoriteButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DropFavoriteButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }
      }
    }
  }

  Group {
    Anchor: (Height: 12);
  }

  Group #DropsContainer {
    LayoutMode: Top;

    Label #DropsTitle {
      Text: "Obtained From";
      Anchor: (Height: 24);
      Padding: (Left: 8);
      Style: (
        FontSize: 16,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #NoDropsContainer {
      Anchor: (Height: 35);
      Visible: true;

      Label #NoDropsLabel {
        Text: "No drop sources found!";
        Anchor: (Height: 24);
        Style: (
          FontSize: 14,
          TextColor: #ff4444,
          HorizontalAlignment: Center,
          RenderBold: true
        );
      }
    }

    Group #DropsContent {
      LayoutMode: Top;
      Visible: false;

      Group #MobDropsSection {
        LayoutMode: Top;
        Padding: (Full: 12);
        Background: #16202c(0.86);
        Visible: false;

        Label #MobDropsTitle {
          Text: "Mob Drops";
          Anchor: (Height: 22);
          Style: (
            FontSize: 15,
            TextColor: #96a9be,
            RenderBold: true
          );
        }

        Group {
          Anchor: (Height: 10);
        }

        Group #MobDropCarousel {
          LayoutMode: Left;
          Anchor: (Height: 164);

          Group {
            Anchor: (Width: 92, Height: 164);
            LayoutMode: Center;

            $C.@SmallSecondaryTextButton #MobDropPrevButton {
              @Text = "PREV";
              @Anchor = (Width: 84, Height: 32);
            }
          }

          Group {
            Anchor: (Width: 12);
          }

          Group #MobDropCard {
            FlexWeight: 1;
            LayoutMode: Top;
            Padding: (Full: 10);
            Background: #182331(0.78);

            Group #MobDropImageArea {
              Anchor: (Height: 92);
              LayoutMode: Center;

              Group #MobDropImageFrame {
                Anchor: (Width: 92, Height: 92);
                Background: #1a2836(0.86);

                Group {
                  Anchor: (Top: 6, Bottom: 6, Left: 6, Right: 6);
                  LayoutMode: Center;

                  Group #MobDropPortrait {
                    Anchor: (Width: 72, Height: 72);
                    Background: #000000(0);
                    Visible: false;
                  }

                  Label #MobDropPortraitFallback {
                    Text: "No portrait";
                    Anchor: (Width: 72, Height: 24);
                    Style: (
                      FontSize: 9,
                      TextColor: #6f8598,
                      HorizontalAlignment: Center,
                      VerticalAlignment: Center,
                      RenderUppercase: true
                    );
                    Visible: false;
                  }
                }

                Button #MobDropInteractButton {
                  Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
                  Background: #000000(0);
                  Padding: (Full: 0);
                  Style: ButtonStyle(
                    Default: (Background: #000000(0)),
                    Hovered: (Background: #7db0db(0.18)),
                    Pressed: (Background: #7db0db(0.28))
                  );
                }
              }
            }

            Group {
              Anchor: (Height: 10);
            }

            Label #MobDropName {
              Text: "";
              Anchor: (Height: 22);
              Style: (
                FontSize: 14,
                TextColor: #d8e2ec,
                HorizontalAlignment: Center,
                VerticalAlignment: Center,
                RenderBold: true
              );
            }

            Group {
              Anchor: (Height: 4);
            }

            Label #MobDropCounter {
              Text: "";
              Anchor: (Height: 16);
              Style: (
                FontSize: 10,
                TextColor: #8fa4ba,
                HorizontalAlignment: Center,
                VerticalAlignment: Center,
                RenderBold: true
              );
            }
          }

          Group {
            Anchor: (Width: 12);
          }

          Group {
            Anchor: (Width: 92, Height: 164);
            LayoutMode: Center;

            $C.@SmallSecondaryTextButton #MobDropNextButton {
              @Text = "NEXT";
              @Anchor = (Width: 84, Height: 32);
            }
          }
        }
      }

      Group #OtherDropsSpacer {
        Anchor: (Height: 12);
        Visible: false;
      }

      Group #OtherDropsSection {
        LayoutMode: Top;
        Visible: false;

        Label #OtherDropsTitle {
          Text: "Other Drops";
          Anchor: (Height: 22);
          Padding: (Left: 6);
          Style: (
            FontSize: 15,
            TextColor: #96a9be,
            RenderBold: true
          );
        }

        Group #OtherDropsListSection {
          LayoutMode: Top;

          Group {
            Anchor: (Height: 6);
          }

          Group #OtherDropSourcesList {
            LayoutMode: Top;
          }
        }
      }
    }
  }

  Group {
    Anchor: (Height: 12);
  }

  Group #DetailsContainer {
    LayoutMode: Top;
    Padding: (Full: 12);
    Background: #16202c(0.86);

    Label #DetailsTitle {
      Text: "Item Information";
      Anchor: (Height: 22);
      Style: (
        FontSize: 15,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #ItemIdRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "ID:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailItemId {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #MaxStackRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "Max Stack:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailMaxStack {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #DurabilityRow {
      LayoutMode: Left;
      Anchor: (Height: 18);

      Label {
        Text: "Durability:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailDurability {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }
  }
}
