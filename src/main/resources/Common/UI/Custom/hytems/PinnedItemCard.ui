Group {
  LayoutMode: Top;
  Anchor: (Width: 280);
  Background: #1e1e1e(0.8);
  Padding: (Full: 12);

  Group #Header {
    LayoutMode: Left;
    Anchor: (Height: 48);
    Padding: (Bottom: 10);
    
    ItemIcon #ItemIcon {
      Anchor: (Width: 44, Height: 44);
      Visible: true;
    }
    
    Group {
      Anchor: (Width: 10);
    }
    
    Label #ItemName {
      FlexWeight: 1;
      Style: (
        FontSize: 15,
        TextColor: #ffffff,
        VerticalAlignment: Center,
        RenderBold: true
      );
    }
  }

  Group {
    Anchor: (Height: 4);
  }

  Group #Controls {
    LayoutMode: Left;
    Anchor: (Height: 36);

    Group #MoveLeftBtn {
      Anchor: (Width: 60, Height: 32);
      Background: #3d6799;
      Padding: (Horizontal: 8, Vertical: 6);
      
      Label {
        Style: (
          FontSize: 14,
          TextColor: #ffffff,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
        Text: "←";
      }
    }

    Group {
      Anchor: (Width: 6);
    }

    Group #MoveRightBtn {
      Anchor: (Width: 60, Height: 32);
      Background: #3d6799;
      Padding: (Horizontal: 8, Vertical: 6);
      
      Label {
        Style: (
          FontSize: 14,
          TextColor: #ffffff,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
        Text: "→";
      }
    }

    Group {
      FlexWeight: 1;
    }

    Group #DeleteBtn {
      Anchor: (Width: 80, Height: 32);
      Background: #993d3d;
      Padding: (Horizontal: 8, Vertical: 6);
      
      Label {
        Style: (
          FontSize: 14,
          TextColor: #ffffff,
          HorizontalAlignment: Center,
          VerticalAlignment: Center
        );
        Text: "Remove";
      }
    }
  }
}
