$C = "../../Common.ui";

Group {
  Anchor: (Width: 1180, Height: 780);
  LayoutMode: Top;

  Group #Header {
    Anchor: (Height: 38);
    LayoutMode: Center;
    Padding: (Top: 7);
    Background: (TexturePath: "../../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);

    Label #Title {
      Anchor: (Height: 22);
      Text: "MOB OVERVIEW";
      Style: (
        FontSize: 15,
        TextColor: #b4c8c9,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderUppercase: true,
        RenderBold: true
      );
    }
  }

  Group #Body {
    Anchor: (Top: -1);
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Full: 16);
    Background: (TexturePath: "../../Common/ContainerPatch.png", Border: 23);

    Group #MainContent {
      FlexWeight: 1;
      LayoutMode: Left;

      Group #LeftPanel {
        Anchor: (Width: 300);
        LayoutMode: Top;
        Padding: (Left: 4, Right: 12, Top: 4, Bottom: 4);

        Group #PortraitFrame {
          Anchor: (Height: 188);
          LayoutMode: Center;

          Group #MobPortrait {
            Anchor: (Width: 162, Height: 162);
            Background: #000000(0);
            Visible: true;
          }

          Label #PortraitFallback {
            Anchor: (Height: 26);
            Text: "No image";
            Style: (
              FontSize: 11,
              TextColor: #6f8598,
              HorizontalAlignment: Center,
              VerticalAlignment: Center,
              RenderUppercase: true,
              RenderBold: true
            );
            Visible: false;
          }
        }

        Group {
          Anchor: (Height: 12);
        }

        Label #MobName {
          Anchor: (Height: 34);
          Text: "";
          Style: (
            FontSize: 18,
            TextColor: #ffffff,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
            RenderBold: true,
            Wrap: true
          );
        }

        Group {
          Anchor: (Height: 16);
        }

        Label {
          Anchor: (Height: 22);
          Text: "Attributes";
          Padding: (Left: 4);
          Style: (
            FontSize: 15,
            TextColor: #96a9be,
            RenderBold: true,
            VerticalAlignment: Center
          );
        }

        Group {
          Anchor: (Height: 8);
        }

        Group #AttributesList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }

        Label #NoAttributesLabel {
          Anchor: (Height: 26);
          Text: "No attributes found";
          Style: (
            FontSize: 12,
            TextColor: #8fa4ba,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
          Visible: false;
        }
      }

      Group {
        Anchor: (Width: 14);
      }

      Group #RightPanel {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #DropsVariantsSection {
          Anchor: (Height: 350);
          LayoutMode: Top;
          Padding: (Left: 4, Right: 12, Top: 0, Bottom: 4);

          Label {
            Anchor: (Height: 28);
            Text: "Drops & Variants";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group {
            Anchor: (Height: 8);
          }

          Group #DropsVariantsContent {
            FlexWeight: 1;
            LayoutMode: Top;

            Label #DropsTitle {
              Anchor: (Height: 24);
              Text: "Drops";
              Padding: (Left: 6);
              Style: (
                FontSize: 15,
                TextColor: #d8e2ec,
                RenderBold: true,
                VerticalAlignment: Center
              );
            }

            Group #DropsList {
              LayoutMode: Top;
            }

            Label #NoDropsLabel {
              FlexWeight: 1;
              Text: "No drops found";
              Style: (
                FontSize: 12,
                TextColor: #8fa4ba,
                HorizontalAlignment: Center,
                VerticalAlignment: Center
              );
              Visible: false;
            }

            Group {
              Anchor: (Height: 12);
            }

            Label #VariantsTitle {
              Anchor: (Height: 24);
              Text: "Variants";
              Padding: (Left: 6);
              Style: (
                FontSize: 15,
                TextColor: #d8e2ec,
                RenderBold: true,
                VerticalAlignment: Center
              );
            }

            Group #VariantsList {
              LayoutMode: Top;
            }

            Label #NoVariantsLabel {
              FlexWeight: 1;
              Text: "No variant items found";
              Style: (
                FontSize: 12,
                TextColor: #8fa4ba,
                HorizontalAlignment: Center,
                VerticalAlignment: Center
              );
              Visible: false;
            }
          }
        }

        Group {
          Anchor: (Height: 14);
        }

        Group #SpawnSection {
          Anchor: (Height: 310);
          LayoutMode: Top;
          Padding: (Left: 4, Right: 12, Top: 0, Bottom: 4);

          Label {
            Anchor: (Height: 28);
            Text: "Spawn & Habitat";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group {
            Anchor: (Height: 8);
          }

          Group #SpawnGroups {
            FlexWeight: 1;
            LayoutMode: Top;
          }

          Label #NoSpawnLabel {
            FlexWeight: 1;
            Text: "No spawn data found";
            Style: (
              FontSize: 12,
              TextColor: #8fa4ba,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
            Visible: false;
          }
        }
      }
    }

    Group {
      Anchor: (Height: 12);
    }

    Group #CloseButtonContainer {
      Anchor: (Height: 42);
      LayoutMode: Left;

      Group {
        FlexWeight: 1;
      }

      $C.@SecondaryTextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 128, Height: 38);
      }

      Group {
        Anchor: (Width: 12);
      }

      $C.@CancelTextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 128, Height: 38);
      }

      Group {
        FlexWeight: 1;
      }
    }
  }
}
