$C = "../../Common.ui";

Group {
  Anchor: (Width: 1180, Height: 780);
  LayoutMode: Top;

  Group #Header {
    Anchor: (Height: 38);
    LayoutMode: Center;
    Padding: (Top: 7);
    Background: (TexturePath: "../../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);

    Label #Title {
      Anchor: (Height: 22);
      Text: "BOSS OVERVIEW";
      Style: (
        FontSize: 15,
        TextColor: #b4c8c9,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderUppercase: true,
        RenderBold: true
      );
    }
  }

  Group #Body {
    Anchor: (Top: -1);
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Full: 16);
    Background: (TexturePath: "../../Common/ContainerPatch.png", Border: 23);

    Group #MainContent {
      FlexWeight: 1;
      LayoutMode: Left;

      Group #LeftPanel {
        Anchor: (Width: 300);
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Left: 4, Right: 12, Top: 4, Bottom: 4);

        Group #PortraitFrame {
          Anchor: (Height: 176);
          LayoutMode: Center;

          Group #BossPortrait {
            Anchor: (Width: 162, Height: 162);
            Background: #000000(0);
          }
        }

        Group {
          Anchor: (Height: 22);
          LayoutMode: Center;

          Group #BossTag {
            Anchor: (Width: 52, Height: 18);
            LayoutMode: Center;
            Background: #8e2a2a(0.95);

            Label {
              Text: "BOSS";
              Style: (
                FontSize: 11,
                TextColor: #ffe2c4,
                RenderBold: true,
                HorizontalAlignment: Center,
                VerticalAlignment: Center
              );
            }
          }
        }

        Label #BossName {
          Anchor: (Height: 34);
          Text: "";
          Style: (
            FontSize: 18,
            TextColor: #ffffff,
            HorizontalAlignment: Center,
            VerticalAlignment: Center,
            RenderBold: true,
            Wrap: true
          );
        }

        Group {
          Anchor: (Height: 8);
        }

        Group #InfoList {
          LayoutMode: Top;
        }

        Group {
          Anchor: (Height: 10);
        }

        Group #DifficultyRow {
          Anchor: (Height: 44);
          LayoutMode: Left;

          $C.@TextButton #NormalButtonActive {
            @Text = "Normal";
            @Anchor = (Width: 136);
          }

          $C.@SecondaryTextButton #NormalButton {
            @Text = "Normal";
            @Anchor = (Width: 136);
          }

          Group {
            Anchor: (Width: 12);
          }

          $C.@TextButton #HardButtonActive {
            @Text = "Hard";
            @Anchor = (Width: 136);
          }

          $C.@SecondaryTextButton #HardButton {
            @Text = "Hard";
            @Anchor = (Width: 136);
          }
        }

        Group #DifficultySpacer {
          Anchor: (Height: 10);
        }

        Label #BossDescription {
          Anchor: (Height: 120);
          Text: "";
          Padding: (Left: 6, Right: 6);
          Style: (
            FontSize: 12,
            TextColor: #b9c7d6,
            Wrap: true
          );
        }

        Group {
          Anchor: (Height: 12);
        }

        Label #AttributesTitle {
          Anchor: (Height: 24);
          Text: "Attributes";
          Padding: (Left: 4);
          Style: (
            FontSize: 15,
            TextColor: #96a9be,
            RenderBold: true,
            VerticalAlignment: Center
          );
        }

        Group {
          Anchor: (Height: 6);
        }

        Group #AttributesList {
          LayoutMode: Top;
        }

        Label #NoAttributesLabel {
          Anchor: (Height: 26);
          Text: "No attributes found";
          Style: (
            FontSize: 12,
            TextColor: #8fa4ba,
            HorizontalAlignment: Center,
            VerticalAlignment: Center
          );
          Visible: false;
        }
      }

      Group {
        Anchor: (Width: 14);
      }

      Group #RightPanel {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #PhasesSection {
          Anchor: (Height: 200);
          LayoutMode: Top;
          Padding: (Left: 4, Right: 12, Bottom: 4);

          Label {
            Anchor: (Height: 28);
            Text: "Fight Phases";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group {
            Anchor: (Height: 8);
          }

          Group #PhasesList {
            LayoutMode: Top;
          }
        }

        Group #PhasesDropsSpacer {
          Anchor: (Height: 14);
        }

        Group #DropsSection {
          Anchor: (Height: 120);
          LayoutMode: Top;
          Padding: (Left: 4, Right: 12, Bottom: 4);

          Label {
            Anchor: (Height: 28);
            Text: "Drops & Rewards";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group {
            Anchor: (Height: 8);
          }

          Label #RewardLabel {
            Anchor: (Height: 24);
            Text: "";
            Padding: (Left: 6);
            Style: (
              FontSize: 13,
              TextColor: #e8a93b,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group #DropsList {
            LayoutMode: Top;
          }

          Label #NoDropsLabel {
            Anchor: (Height: 28);
            Text: "No drops found";
            Style: (
              FontSize: 12,
              TextColor: #8fa4ba,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
            Visible: false;
          }
        }

        Group #DropsSpawnSpacer {
          Anchor: (Height: 14);
        }

        Group #SpawnSection {
          Anchor: (Height: 120);
          LayoutMode: Top;
          Padding: (Left: 4, Right: 12, Bottom: 4);

          Label {
            Anchor: (Height: 28);
            Text: "Where to find";
            Style: (
              FontSize: 18,
              TextColor: #96a9be,
              RenderBold: true,
              VerticalAlignment: Center
            );
          }

          Group {
            Anchor: (Height: 8);
          }

          Label #NoSpawnLabel {
            Anchor: (Height: 28);
            Text: "No spawn data found";
            Style: (
              FontSize: 12,
              TextColor: #8fa4ba,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
            Visible: false;
          }

          Group #SpawnGroups {
            LayoutMode: Top;
          }
        }
      }
    }

    Group {
      Anchor: (Height: 12);
    }

    Group #CloseButtonContainer {
      Anchor: (Height: 42);
      LayoutMode: Left;

      Group {
        FlexWeight: 1;
      }

      $C.@SecondaryTextButton #BackButton {
        @Text = "Back";
        @Anchor = (Width: 128, Height: 38);
      }

      Group {
        Anchor: (Width: 12);
      }

      $C.@CancelTextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 128, Height: 38);
      }

      Group {
        FlexWeight: 1;
      }
    }
  }
}
