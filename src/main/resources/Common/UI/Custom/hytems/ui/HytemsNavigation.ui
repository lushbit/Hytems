$C = "../../Common.ui";

Group {
  Anchor: (Width: 980, Height: 420);
  LayoutMode: Top;

  Group #Header {
    Anchor: (Height: 38);
    LayoutMode: Center;
    Padding: (Top: 7);
    Background: (TexturePath: "../../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);

    Label #Title {
      Anchor: (Height: 22);
      Text: "HYTEMS";
      Style: (
        FontSize: 15,
        TextColor: #b4c8c9,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderUppercase: true,
        RenderBold: true
      );
    }
  }

  Group #Body {
    Anchor: (Top: -1);
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: (TexturePath: "../../Common/ContainerPatch.png", Border: 23);

    Group #MenuButtons {
      FlexWeight: 1;
      LayoutMode: Center;

      Group {
        LayoutMode: Left;

        Group #PinsCard {
          Anchor: (Width: 260, Height: 260);
          Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 23);

          Group #PinsIcon {
            Anchor: (Top: 24, Left: 54, Width: 152, Height: 152);
            Background: (TexturePath: "hytems/textures/pin_icon.png");
          }

          Label #PinsLabel {
            Anchor: (Left: 12, Right: 12, Bottom: 44, Height: 30);
            Text: "Pins";
            Style: (
              FontSize: 18,
              TextColor: #ffffff,
              HorizontalAlignment: Center,
              VerticalAlignment: Center,
              RenderBold: true
            );
          }

          Button #PinsButton {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #7db0db(0.18)),
              Pressed: (Background: #7db0db(0.28))
            );
          }
        }

        Group { Anchor: (Width: 24); }

        Group #BrowserCard {
          Anchor: (Width: 260, Height: 260);
          Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 23);

          Group #BrowserIcon {
            Anchor: (Top: 24, Left: 54, Width: 152, Height: 152);
            Background: (TexturePath: "hytems/textures/item_browser_icon.png");
          }

          Label #BrowserLabel {
            Anchor: (Left: 12, Right: 12, Bottom: 44, Height: 30);
            Text: "Item Browser";
            Style: (
              FontSize: 18,
              TextColor: #ffffff,
              HorizontalAlignment: Center,
              VerticalAlignment: Center,
              RenderBold: true
            );
          }

          Button #BrowserButton {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #7db0db(0.18)),
              Pressed: (Background: #7db0db(0.28))
            );
          }
        }

        Group { Anchor: (Width: 24); }

        Group #MobsCard {
          Anchor: (Width: 260, Height: 260);
          Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 23);

          Group #MobsIcon {
            Anchor: (Top: 24, Left: 54, Width: 152, Height: 152);
            Background: (TexturePath: "hytems/textures/mob_browser_icon.png");
          }

          Label #MobsLabel {
            Anchor: (Left: 12, Right: 12, Bottom: 44, Height: 30);
            Text: "Mob Browser";
            Style: (
              FontSize: 18,
              TextColor: #ffffff,
              HorizontalAlignment: Center,
              VerticalAlignment: Center,
              RenderBold: true
            );
          }

          Button #MobsButton {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #7db0db(0.18)),
              Pressed: (Background: #7db0db(0.28))
            );
          }
        }
      }
    }

    Group #CloseButtonContainer {
      Anchor: (Height: 42);
      LayoutMode: Center;

      $C.@CancelTextButton #CloseButton {
        @Text = "Close";
        @Anchor = (Width: 140, Height: 38);
      }
    }
  }
}
