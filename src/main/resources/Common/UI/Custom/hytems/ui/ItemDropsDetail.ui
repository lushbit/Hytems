$C = "../../Common.ui";

Group #DropDetailContent {
  LayoutMode: Top;

  Group #ItemHeader {
    LayoutMode: Left;
    Anchor: (Height: 124);
    Padding: (Full: 10);
    Background: #172331(0.88);

    Group {
      Anchor: (Width: 70, Height: 70);
      Background: #ffffff(0.04);
      LayoutMode: Center;

      ItemIcon #DropDetailItemIcon {
        Anchor: (Width: 64, Height: 64);
        Visible: true;
      }
    }

    Group {
      Anchor: (Width: 12);
    }

    Group #NameSection {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 16);

      Label #DropDetailItemName {
        Text: "";
        Anchor: (Height: 30);
        Style: (
          FontSize: 17,
          TextColor: #ffffff,
          RenderBold: true,
          VerticalAlignment: Center
        );
      }

      Group {
        Anchor: (Height: 10);
      }

      Group #ItemActions {
        Anchor: (Height: 28);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DropPinButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DropPinButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }

        Group {
          Anchor: (Width: 10);
        }

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DropFavoriteButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DropFavoriteButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }
      }
    }
  }

  Group {
    Anchor: (Height: 12);
  }

  Group #DropsContainer {
    LayoutMode: Top;

    Label #DropsTitle {
      Text: "Obtained From";
      Anchor: (Height: 24);
      Padding: (Left: 8);
      Style: (
        FontSize: 16,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #NoDropsContainer {
      Anchor: (Height: 35);
      Visible: true;

      Label #NoDropsLabel {
        Text: "No drop sources found!";
        Anchor: (Height: 24);
        Style: (
          FontSize: 14,
          TextColor: #ff4444,
          HorizontalAlignment: Center,
          RenderBold: true
        );
      }
    }

    Group #DropsContent {
      LayoutMode: Top;
      Visible: false;

      Group #DropsSection {
        LayoutMode: Top;

        Group {
          Anchor: (Height: 6);
        }

        Group #DropSourcesList {
          LayoutMode: Top;
        }
      }
    }
  }

  Group {
    Anchor: (Height: 12);
  }

  Group #DetailsContainer {
    LayoutMode: Top;
    Padding: (Full: 12);
    Background: #16202c(0.86);

    Label #DetailsTitle {
      Text: "Item Information";
      Anchor: (Height: 22);
      Style: (
        FontSize: 15,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #ItemIdRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "ID:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailItemId {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #MaxStackRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "Max Stack:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailMaxStack {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #DurabilityRow {
      LayoutMode: Left;
      Anchor: (Height: 18);

      Label {
        Text: "Durability:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DropDetailDurability {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }
  }
}
