$C = "../../Common.ui";

Group {
  Anchor: (Width: 1680, Height: 1010);
  LayoutMode: Top;

  Group #Header {
    Anchor: (Height: 38);
    LayoutMode: Center;
    Padding: (Top: 7);
    Background: (TexturePath: "../../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);

    Label #Title {
      Anchor: (Height: 22);
      Text: "ITEM BROWSER";
      Style: (
        FontSize: 15,
        TextColor: #b4c8c9,
        HorizontalAlignment: Center,
        VerticalAlignment: Center,
        RenderUppercase: true,
        RenderBold: true
      );
    }
  }

  Group #BrowserContainer {
    Anchor: (Top: -1);
    FlexWeight: 1;
    LayoutMode: Top;
    Padding: (Full: 16);
    Background: (TexturePath: "../../Common/ContainerPatch.png", Border: 23);

    Group {
      Anchor: (Height: 2);
    }

    Group #MainContent {
      FlexWeight: 1;
      LayoutMode: Left;

      Group #LeftSpacePanel {
        Anchor: (Width: 320);
        LayoutMode: Top;

        Group #LeftFiltersPanel {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Top: 20, Left: 22, Right: 22);

          Label {
            Anchor: (Height: 28);
            Text: "FILTERS";
            Style: (
              FontSize: 18,
              TextColor: #b4c8c9,
              VerticalAlignment: Center,
              RenderUppercase: true,
              RenderBold: true
            );
          }

          Label { Anchor: (Height: 20); Text: "Category"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #CategoryFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 6); }

          Label { Anchor: (Height: 20); Text: "Mod"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #ModFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 6); }

          Label { Anchor: (Height: 20); Text: "Craftable"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #CraftableFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 6); }

          Label { Anchor: (Height: 20); Text: "Droppable"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #DroppableFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 6); }

          Label { Anchor: (Height: 20); Text: "Pinned"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #PinnedFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 6); }

          Label { Anchor: (Height: 20); Text: "Sorting"; Style: (FontSize: 13, TextColor: #b4c8c9, VerticalAlignment: Center); }
          $C.@DropdownBox #SortingFilter { Anchor: (Width: 276, Height: 28); }
          Group { Anchor: (Height: 10); }

          TextButton #ResetFiltersButton {
            Anchor: (Width: 140, Height: 26);
            Text: "RESET FILTERS";
            Style: (...$C.@CancelTextButtonStyle);
          }

          Label {
            Anchor: (Height: 38);
            Padding: (Top: 14);
            Text: "SETTINGS";
            Style: (FontSize: 18, TextColor: #b4c8c9, VerticalAlignment: Center, RenderUppercase: true, RenderBold: true);
          }

          $C.@CheckBoxWithLabel #ShowSalvagerRecipes {
            @Text = "Show Salvager Recipes";
            Padding: (Top: 2);
          }

          Group { Anchor: (Height: 4); }

          $C.@CheckBoxWithLabel #ShowHiddenItems {
            @Text = "Show Hidden Items";
            Padding: (Top: 2);
          }
        }

        Group #NavigationSection {
          LayoutMode: Top;
          Padding: (Left: 22, Right: 22, Bottom: 4);

          Label {
            Anchor: (Height: 38);
            Padding: (Top: 14);
            Text: "NAVIGATION";
            Style: (FontSize: 18, TextColor: #b4c8c9, VerticalAlignment: Center, RenderUppercase: true, RenderBold: true);
          }

          Group {
            Anchor: (Height: 10);
          }

          Group {
            LayoutMode: Left;

            $C.@SecondaryTextButton #BackButton {
              @Text = "BACK";
              @Anchor = (Width: 120, Height: 28);
            }

            Group #BackButtonSpacer {
              Anchor: (Width: 12);
            }

            $C.@CancelTextButton #CloseButton {
              @Text = "CLOSE";
              @Anchor = (Width: 120, Height: 28);
            }
          }
        }
      }

      Group {
        Anchor: (Width: 12);
      }

      Group #CenterBrowserPanel {
        Anchor: (Width: 844);
        LayoutMode: Top;
        Padding: (Top: 0, Left: 8, Right: 8, Bottom: 8);

        Group #GridSection {
          Anchor: (Height: 744);

          Group #ItemGrid {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            LayoutMode: Top;
          }

        }

        Group {
          Anchor: (Height: 10);
        }

        Group #PaginationSection {
          Anchor: (Height: 52);
          LayoutMode: Top;

          Group {
            Anchor: (Height: 34);
            LayoutMode: Center;

            Group #PaginationControls {
              Anchor: (Width: 334, Height: 34);
              LayoutMode: Left;

              $C.@SecondaryTextButton #PrevPageButton {
                @Text = "PREV";
                @Anchor = (Width: 84, Height: 28, Top: 4);
              }

              Group {
                Anchor: (Width: 10);
              }

              Group {
                Anchor: (Width: 146, Height: 34);
                LayoutMode: Center;

                Label #PageLabel {
                  Anchor: (Height: 34);
                  Text: "Page 1 / 1";
                  Style: (
                    FontSize: 16,
                    RenderBold: true,
                    TextColor: #d0d7df,
                    HorizontalAlignment: Center,
                    VerticalAlignment: Center
                  );
                }
              }

              Group {
                Anchor: (Width: 10);
              }

              $C.@SecondaryTextButton #NextPageButton {
                @Text = "NEXT";
                @Anchor = (Width: 84, Height: 28, Top: 4);
              }
            }
          }

          Label #ItemCountLabel {
            Anchor: (Height: 18);
            Text: "0 items found";
            Style: (
              FontSize: 11,
              RenderBold: false,
              TextColor: #b4c8c9,
              HorizontalAlignment: Center,
              VerticalAlignment: Center
            );
          }
        }

        Group {
          FlexWeight: 1;
        }

        Group #BottomSearchBlock {
          Anchor: (Height: 137);
          LayoutMode: Top;

          Group #SearchHistorySection {
            Anchor: (Height: 81);
            LayoutMode: Center;

            Group #SearchHistorySlot {
              Anchor: (Width: 760, Height: 81);
            }
          }

          Group {
            Anchor: (Height: 10);
          }

          Group #SearchSection {
            LayoutMode: Center;
            Anchor: (Height: 46);

            Group #SearchFrame {
              Anchor: (Width: 760, Height: 42);
              LayoutMode: Center;
              Padding: (Full: 2);
              Background: $C.@InputBoxBackground;

              Group {
                Anchor: (Width: 752, Height: 38);
                LayoutMode: Center;

                CompactTextField #SearchInput {
                  Anchor: (Width: 744, Height: 38);
                  CollapsedWidth: 744;
                  ExpandedWidth: 744;
                  PlaceholderText: "Search items...";
                  Style: (FontSize: 14, TextColor: #ffffff);
                  PlaceholderStyle: (TextColor: #6e7da1, FontSize: 14);
                  Padding: (Horizontal: 12, Left: 36, Right: 38);
                  Decoration: (
                    Default: (
                      Icon: (Texture: "../../Common/SearchIcon.png", Width: 16, Height: 16, Offset: 10),
                      ClearButtonStyle: $C.@ClearButtonStyle
                    )
                  );
                }
              }
            }
          }
        }
      }

      Group {
        Anchor: (Width: 12);
      }

      Group #InfoPanelSlot {
        Anchor: (Width: 460);
        LayoutMode: Top;
        Padding: (Full: 10);
      }
    }

  }
}
