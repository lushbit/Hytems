$C = "../../Common.ui";

Group #DetailContent {
  LayoutMode: Top;

  Group #ItemHeader {
    LayoutMode: Left;
    Anchor: (Height: 124);
    Padding: (Full: 10);
    Background: #172331(0.88);

    Group {
      Anchor: (Width: 70, Height: 70);
      Background: #ffffff(0.04);
      LayoutMode: Center;

      ItemIcon #DetailItemIcon {
        Anchor: (Width: 64, Height: 64);
        Visible: true;
      }
    }
    Group {
      Anchor: (Width: 12);
    }

    Group #NameSection {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 16);

      Label #DetailItemName {
        Text: "";
        Anchor: (Height: 30);
        Style: (
          FontSize: 17,
          TextColor: #ffffff,
          RenderBold: true,
          VerticalAlignment: Center
        );
      }

      Group {
        Anchor: (Height: 10);
      }

      Group #ItemActions {
        Anchor: (Height: 28);
        LayoutMode: Left;

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DetailPinButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DetailPinButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }

        Group {
          Anchor: (Width: 10);
        }

        Group {
          Anchor: (Width: 26, Height: 26);

          Button #DetailFavoriteButtonEmpty {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
          }

          Button #DetailFavoriteButtonFilled {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #000000(0)),
              Pressed: (Background: #000000(0))
            );
            Visible: false;
          }
        }
      }
    }
  }
  Group {
    Anchor: (Height: 12);
  }

  Group #RecipeContainer {
    LayoutMode: Top;

    Label #RecipeTitle {
      Text: "Recipes";
      Anchor: (Height: 24);
      Padding: (Left: 8);
      Style: (
        FontSize: 16,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #NoRecipeContainer {
      Anchor: (Height: 35);
      Visible: true;

      Label #NoRecipeLabel {
        Text: "No recipe found!";
        Anchor: (Height: 24);
        Style: (
          FontSize: 14,
          TextColor: #ff4444,
          HorizontalAlignment: Center,
          RenderBold: true
        );
      }
    }

    Group #RecipeContent {
      LayoutMode: Top;
      Visible: false;

      Group #CraftingStationSection {
        LayoutMode: Top;
        Padding: (Bottom: 10);

        Label #CraftingStationLabel {
          Text: "Can be crafted at:";
          Anchor: (Height: 20);
          Padding: (Left: 8);
          Style: (
            FontSize: 14,
            TextColor: #96a9be
          );
        }

        Group {
          Anchor: (Height: 6);
        }

        Group #StationInfo {
          Anchor: (Height: 72);
          Background: #223044(0.72);

          Group #StationIconBackground {
            Anchor: (Left: 10, Top: 12, Width: 48, Height: 48);
            Background: "hytems/textures/rarity_default.png";
            LayoutMode: Center;

            ItemIcon #StationIcon {
              Anchor: (Width: 42, Height: 42);
              Visible: true;
            }

            AssetImage #StationAssetIcon {
              Anchor: (Width: 42, Height: 42);
              Visible: false;
            }
          }

          Label #StationName {
            Text: "";
            Anchor: (Left: 70, Right: 12, Top: 13, Height: 22);
            Style: (
              FontSize: 15,
              TextColor: #ffffff,
              RenderBold: true
            );
          }

          Label #StationTier {
            Text: "";
            Anchor: (Left: 70, Right: 12, Top: 42, Height: 16);
            Style: (
              FontSize: 12,
              TextColor: #aaaaaa
            );
          }

          Button #StationPathButton {
            Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
            Background: #000000(0);
            Padding: (Full: 0);
            Style: ButtonStyle(
              Default: (Background: #000000(0)),
              Hovered: (Background: #7db0db(0.2)),
              Pressed: (Background: #7db0db(0.3))
            );
            Visible: false;
          }
        }
      }

      Group {
        Anchor: (Height: 10);
      }

      Group #IngredientsSection {
        LayoutMode: Top;

        Label #IngredientsLabel {
          Text: "Items needed to craft:";
          Anchor: (Height: 20);
          Padding: (Left: 8);
          Style: (
            FontSize: 14,
            TextColor: #96a9be
          );
        }

        Group {
          Anchor: (Height: 6);
        }

        Group #IngredientsList {
          LayoutMode: Top;
        }
      }
    }

    Group #SalvagerRecipesSection {
      LayoutMode: Top;
      Visible: false;
      Padding: (Top: 10);

      Label #SalvagerStationLabel {
        Text: "Can be salvaged at:";
        Anchor: (Height: 20);
        Padding: (Left: 8);
        Style: (FontSize: 14, TextColor: #96a9be);
      }

      Group { Anchor: (Height: 6); }

      Group #SalvagerStationInfo {
        Anchor: (Height: 72);
        Background: #223044(0.72);

        Group #SalvagerStationIconBackground {
          Anchor: (Left: 10, Top: 12, Width: 48, Height: 48);
          Background: "hytems/textures/rarity_default.png";
          LayoutMode: Center;

          ItemIcon #SalvagerStationIcon {
            Anchor: (Width: 42, Height: 42);
            Visible: true;
          }

          AssetImage #SalvagerStationAssetIcon {
            Anchor: (Width: 42, Height: 42);
            Visible: false;
          }
        }

        Label #SalvagerStationName {
          Text: "";
          Anchor: (Left: 70, Right: 12, Top: 13, Height: 22);
          Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true);
        }

        Label #SalvagerStationTier {
          Text: "";
          Anchor: (Left: 70, Right: 12, Top: 42, Height: 16);
          Style: (FontSize: 12, TextColor: #aaaaaa);
        }

        Button #SalvagerStationPathButton {
          Anchor: (Top: 0, Bottom: 0, Left: 0, Right: 0);
          Background: #000000(0);
          Padding: (Full: 0);
          Style: ButtonStyle(
            Default: (Background: #000000(0)),
            Hovered: (Background: #7db0db(0.2)),
            Pressed: (Background: #7db0db(0.3))
          );
          Visible: false;
        }
      }

      Group { Anchor: (Height: 10); }

      Label #SalvagerIngredientsLabel {
        Text: "Items that can be salvaged:";
        Anchor: (Height: 20);
        Padding: (Left: 8);
        Style: (FontSize: 14, TextColor: #96a9be);
      }

      Group { Anchor: (Height: 6); }

      Group #SalvagerIngredientsList {
        LayoutMode: Top;
      }
    }
  }

  Group {
    Anchor: (Height: 12);
  }

  Group #DetailsContainer {
    LayoutMode: Top;
    Padding: (Full: 12);
    Background: #16202c(0.86);

    Label #DetailsTitle {
      Text: "Item Information";
      Anchor: (Height: 22);
      Style: (
        FontSize: 15,
        TextColor: #96a9be,
        RenderBold: true
      );
    }

    Group {
      Anchor: (Height: 8);
    }

    Group #ItemIdRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "ID:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DetailItemId {
        FlexWeight: 1;
        Text: "";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #MaxStackRow {
      LayoutMode: Left;
      Anchor: (Height: 18);
      Padding: (Bottom: 4);

      Label {
        Text: "Max Stack:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DetailMaxStack {
        FlexWeight: 1;
        Text: "-";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }

    Group #DurabilityRow {
      LayoutMode: Left;
      Anchor: (Height: 18);

      Label {
        Text: "Durability:";
        Anchor: (Width: 80);
        Style: (
          FontSize: 11,
          TextColor: #888888
        );
      }

      Label #DetailDurability {
        FlexWeight: 1;
        Text: "-";
        Style: (
          FontSize: 11,
          TextColor: #cccccc
        );
      }
    }
  }
}
