Group {
  LayoutMode: Top;
  Anchor: (Height: 56);
  Padding: (Left: 6, Right: 8, Bottom: 6, Top: 6);
  Background: #182331(0.78);

  Label #SourceName {
    Text: "";
    Anchor: (Height: 20);
    Padding: (Left: 8);
    Style: (
      FontSize: 14,
      TextColor: #d8e2ec,
      VerticalAlignment: Center,
      RenderBold: true
    );
  }

  Label #SourceContext {
    Text: "";
    Anchor: (Height: 16);
    Padding: (Left: 8, Right: 8);
    Style: (
      FontSize: 10,
      TextColor: #8fa4ba,
      VerticalAlignment: Center
    );
    Visible: false;
  }
}
